         enum {
@@ -916,7 +916,7 @@ namespace Argum {
 
         res = Impl::simpleWidth(stripped.data(), stripped.size());
         if (res >= 0)
-            return res;
+            return static_cast<unsigned>(res);
         
         return unsigned(stripped.size());
     }
