From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rohit Goswami <rgoswami@ieee.org>
Date: Mon, 16 Nov 2026 07:50:20 -0600
Subject: [PATCH] fix: squash the four local argum v2.9 patches

Explicit static_cast fixes for -Wconversion/-Wsign-conversion/-Wshadow
(49eddbd2, 5dd4e626), a Windows.h casing fix for MinGW (b9926795), and
alias()/addHidden()/visible() for a hidden --colour-types alias
(f31a388a). See third_party/argum/NOTICE.md for the full history.

diff --git a/single-file/argum.h b/single-file/argum.h
index ba4d6dc..19776e3 100644
--- a/single-file/argum.h
+++ b/single-file/argum.h
@@ -59,7 +59,7 @@
     #ifndef WIN32_LEAN_AND_MEAN
         #define WIN32_LEAN_AND_MEAN
     #endif
-    #include <Windows.h>
+    #include <windows.h>
     #ifdef min
         #undef min
     #endif
@@ -330,7 +330,7 @@ namespace Argum {
     #undef ARGUM_DEFINE_CHAR_CONSTANTS
     
     inline auto CharConstants<char>::isSpace(char c) -> bool { return isspace(c); }
-    inline auto CharConstants<wchar_t>::isSpace(wchar_t c) -> bool { return iswspace(c); }
+    inline auto CharConstants<wchar_t>::isSpace(wchar_t c) -> bool { return iswspace(static_cast<wint_t>(c)); }
 
     inline auto CharConstants<char>::toLong(const char * str, char ** str_end, int base) -> long {
         return strtol(str, str_end, base);
@@ -859,7 +859,7 @@ namespace Argum {
 
         int res = Impl::simpleWidth(str.data(), str.size());
         if (res >= 0)
-            return res;
+            return static_cast<unsigned>(res);
         
