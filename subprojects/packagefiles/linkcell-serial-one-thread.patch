+}
+
+thread_local! {
+    #[allow(clippy::missing_const_for_thread_local)]
+    static PARKED_ROWS: RefCell<Option<ParkedRows>> = RefCell::new(None);
+}
+
+fn take_parked_rows(key: &PairKey<'_>) -> Option<Vec<crate::pairs::Pair>> {
+    let parked = PARKED_ROWS.with(|slot| slot.borrow_mut().take())?;
+    let mask_same = match (&parked.mask, key.mask) {
+        (None, None) => true,
+        (Some(a), Some(b)) => a.len() == b.len() && a.iter().zip(b).all(|(&x, &y)| x == (y != 0)),
+        _ => false,
+    };
+    let same = parked.half == key.half
+        && parked.cutoff == key.cutoff.to_bits()
+        && parked.cell_hint == key.cell_hint.map(f64::to_bits)
+        && parked.simbox == box_bits(&key.simbox)
+        && mask_same
+        && same_bits(&parked.xyz, key.xyz);
+    if same {
+        Some(parked.pairs)
+    } else {
+        None
+    }
+}
+
+fn park_rows(key: &PairKey<'_>, pairs: Vec<crate::pairs::Pair>) {
+    let parked = ParkedRows {
+        xyz: key.xyz.to_vec(),
+        simbox: box_bits(&key.simbox),
+        cutoff: key.cutoff.to_bits(),
+        mask: key.mask.map(|m| m.iter().map(|&v| v != 0).collect()),
+        cell_hint: key.cell_hint.map(f64::to_bits),
+        half: key.half,
+        pairs,
+    };
+    PARKED_ROWS.with(|slot| *slot.borrow_mut() = Some(parked));
+}
