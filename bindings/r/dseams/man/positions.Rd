\name{positions}
\alias{positions}
\alias{positions.dseams_frame}
\alias{print.dseams_frame}
\title{Frame coordinates}
\usage{
positions(frame)
}
\arguments{
\item{frame}{A \code{dseams_frame}.}
}
\value{
A numeric matrix with columns \code{x}, \code{y}, \code{z}.
}
\description{
Cartesian coordinates of one frame, in angstrom.
}
