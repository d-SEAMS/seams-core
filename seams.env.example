# Twelve-factor runtime knobs for d-SEAMS.
# Copy to ./seams.env or point SEAMS_CONFIG at this file.
# Already-set environment variables win over this file.
# CLI flags (--k, --tpp, --resident, ...) win over the environment.

# SEAMS_FRAME=1
# SEAMS_LAST=0
# SEAMS_JOBS=1
# SEAMS_TYPE=0
# SEAMS_CUTOFF=3.5
# Face-edge window for cages --signature, in the file's coordinate units.
# none leaves the cage bound to the face census. A nanometre file can
# use 0.265,0.315. Widen the window for a compressed cell or a guest
# that stretches a cage.
# SEAMS_CAGE_EDGE=2.65,3.15
# SEAMS_K=4
# SEAMS_GRAPH=seeded
# SEAMS_RESIDENT=0.80
# SEAMS_CELL=3.0
# SEAMS_OFFLOAD=0
# LINKCELL_TPP=4
# LINKCELL_BLOCK=128
# YODA_FENNEL_PATH=
# YODA_LUA_PATH=
