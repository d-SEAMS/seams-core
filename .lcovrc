# Match the gcov that produces the coverage records in the Ubuntu CI job.
geninfo_gcov_tool = /usr/bin/gcov
# Marking unexecuted blocks zeroes lines whose other blocks ran, under-reporting
# executed lines (35,294 reported versus 35,423 with this setting disabled).
geninfo_unexecuted_blocks = 1
# GCC 15 records the declaration line of an uncalled lambda as executed by
# its enclosing function. lcov's consistency check already exempts the first
# line of a C++ lambda, but isLambda() only matches demangled names.
demangle_cpp = c++filt
