#!/bin/sh
# Compilers abort or spend the test budget inside LeakSanitizer when the
# suite has preloaded libasan for Python. Drop it for this process only.
here=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
real=${REAL_CC:-}
if [ -z "$real" ]; then
  old_ifs=$IFS
  IFS=:
  for dir in $PATH; do
    [ "$dir" = "$here" ] && continue
    if [ -x "$dir/cc" ]; then
      real=$dir/cc
      break
    fi
  done
  IFS=$old_ifs
fi
if [ -z "$real" ]; then
  echo "cc is not on PATH" >&2
  exit 1
fi
unset LD_PRELOAD
exec "$real" "$@"
