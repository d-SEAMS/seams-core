#!/bin/sh
here=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
real=${REAL_CXX:-}
if [ -z "$real" ]; then
  old_ifs=$IFS
  IFS=:
  for dir in $PATH; do
    [ "$dir" = "$here" ] && continue
    if [ -x "$dir/c++" ]; then
      real=$dir/c++
      break
    fi
  done
  IFS=$old_ifs
fi
if [ -z "$real" ]; then
  echo "c++ is not on PATH" >&2
  exit 1
fi
unset LD_PRELOAD
exec "$real" "$@"
