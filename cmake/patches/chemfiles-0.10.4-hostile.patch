+void BinaryFile::check_remaining(uint64_t count, uint64_t item_size, const char* what) {
+    auto size = this->file_size();
+    auto position = this->tell();
+    auto remaining = position < size ? size - position : 0;
+    if (item_size == 0) {
+        item_size = 1;
+    }
+    if (count > remaining / item_size) {
+        throw file_error(
+            "{} ({} entries of {} bytes) does not fit in the remaining {} bytes of '{}'",
+            what, count, item_size, remaining, this->path()
+        );
+    }
+}
