# Prevent signed integer overflow in gemmi's CIF number and integer
# parsers (numb.hpp exponent accumulator and atox.hpp integer parsers),
# which previously wrapped large exponents to a negative index into the
# 9-element power-of-10 table and crashed.
diff -ruN gemmi-a/gemmi/include/gemmi/atox.hpp gemmi-b/gemmi/include/gemmi/atox.hpp
--- gemmi-a/gemmi/include/gemmi/atox.hpp	2020-07-30 11:10:02.000000000 +0000
+++ gemmi-b/gemmi/include/gemmi/atox.hpp	2026-11-21 08:18:13.920839871 +0000
@@ -14,6 +14,8 @@
 #ifndef GEMMI_ATOX_HPP_
 #define GEMMI_ATOX_HPP_
 
+#include <climits>    // for INT_MIN, INT_MAX
+#include <cstdint>    // for int64_t
 #include <stdexcept>  // for invalid_argument
 #include <string>
 
@@ -62,8 +64,8 @@
 
 // no checking for overflow
 inline int string_to_int(const char* p, bool checked, size_t length=0) {
-  int mult = -1;
-  int n = 0;
+  int64_t mult = -1;
+  int64_t n = 0;
   size_t i = 0;
   while ((length == 0 || i < length) && is_space(p[i]))
     ++i;
@@ -76,7 +78,12 @@
   bool has_digits = false;
   // use negative numbers because INT_MIN < -INT_MAX
   for (; (length == 0 || i < length) && is_digit(p[i]); ++i) {
-    n = n * 10 - (p[i] - '0');
+    if (n >= INT_MIN / 10) {
+      int64_t next = n * 10 - (p[i] - '0');
+      n = next < INT_MIN ? INT_MIN : next;
+    } else {
+      n = INT_MIN;
+    }
     has_digits = true;
   }
   if (checked) {
@@ -86,7 +93,12 @@
       throw std::invalid_argument("not an integer: " +
                                   std::string(p, length ? length : i+1));
   }
-  return mult * n;
+  int64_t res = mult * n;
+  if (res > INT_MAX)
+    return INT_MAX;
+  if (res < INT_MIN)
+    return INT_MIN;
+  return static_cast<int>(res);
 }
 
 inline int string_to_int(const std::string& str, bool checked) {
@@ -94,8 +106,8 @@
 }
 
 inline int simple_atoi(const char* p, const char** endptr=nullptr) {
-  int mult = -1;
-  int n = 0;
+  int64_t mult = -1;
+  int64_t n = 0;
   while (is_space(*p))
     ++p;
   if (*p == '-') {
@@ -104,22 +116,39 @@
   } else if (*p == '+') {
     ++p;
   }
-  for (; is_digit(*p); ++p)
-    n = n * 10 - (*p - '0'); // use negative numbers because INT_MIN < -INT_MAX
+  for (; is_digit(*p); ++p) {
+    if (n >= INT_MIN / 10) {
+      int64_t next = n * 10 - (*p - '0');
+      n = next < INT_MIN ? INT_MIN : next;
+    } else {
+      n = INT_MIN;
+    }
+  }
   if (endptr)
     *endptr = p;
-  return mult * n;
+  int64_t res = mult * n;
+  if (res > INT_MAX)
+    return INT_MAX;
+  if (res < INT_MIN)
+    return INT_MIN;
+  return static_cast<int>(res);
 }
 
 inline int no_sign_atoi(const char* p, const char** endptr=nullptr) {
-  int n = 0;
+  int64_t n = 0;
   while (is_space(*p))
     ++p;
-  for (; is_digit(*p); ++p)
-    n = n * 10 + (*p - '0');
+  for (; is_digit(*p); ++p) {
+    if (n <= INT_MAX / 10) {
+      int64_t next = n * 10 + (*p - '0');
+      n = next > INT_MAX ? INT_MAX : next;
+    } else {
+      n = INT_MAX;
+    }
+  }
   if (endptr)
     *endptr = p;
-  return n;
+  return static_cast<int>(n);
 }
 
 
diff -ruN gemmi-a/gemmi/include/gemmi/numb.hpp gemmi-b/gemmi/include/gemmi/numb.hpp
--- gemmi-a/gemmi/include/gemmi/numb.hpp	2020-07-30 11:10:02.000000000 +0000
+++ gemmi-b/gemmi/include/gemmi/numb.hpp	2026-11-21 08:17:46.708854242 +0000
@@ -58,8 +58,10 @@
       neg = true;
     else if (*p != '+')
       n = *p - '0';
-    for (++p; p != in.end(); ++p)
-      n = n * 10 + (*p - '0');
+    for (++p; p != in.end(); ++p) {
+      if (n < 10000)
+        n = n * 10 + (*p - '0');
+    }
     // We don't expect too many exponents in CIF files, let's have
     // only this small LUT.
     static const double e[] = { 1e0, 1e1, 1e2, 1e3, 1e4, 1e5, 1e6, 1e7, 1e8 };
