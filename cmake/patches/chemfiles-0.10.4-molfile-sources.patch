diff -ruN molfiles-a/molfiles/src/rst7plugin.c molfiles-b/molfiles/src/rst7plugin.c
--- molfiles-a/molfiles/src/rst7plugin.c	2021-09-10 14:18:46.000000000 +0000
+++ molfiles-b/molfiles/src/rst7plugin.c	2026-11-20 20:59:15.673087209 +0000
@@ -92,15 +92,68 @@
   data->file = fd;
   vmdcon_printf(VMDCON_INFO, "rst7plugin) The Restartcrd has %d atoms.\n",numats);
 
+  /* A count larger than the bytes still in the file cannot be a real
+     restart: each atom needs at least one byte of coordinate text, and
+     velocities the same again. Scanning `numats` times used to spin on
+     EOF when the count was a multi-billion integer. */
+  if (numats < 0) {
+    vmdcon_printf(VMDCON_ERROR, "rst7plugin) atom count is negative\n");
+    free(data);
+    fclose(fd);
+    return NULL;
+  }
+  {
+    long here = ftell(fd);
+    long end = -1;
+    long room;
+    long need = (long)numats;
+    if (here >= 0 && fseek(fd, 0, SEEK_END) == 0)
+      end = ftell(fd);
+    if (here < 0 || end < here || fseek(fd, here, SEEK_SET) != 0) {
+      vmdcon_printf(VMDCON_ERROR, "rst7plugin) could not measure the file\n");
+      free(data);
+      fclose(fd);
+      return NULL;
+    }
+    room = end - here;
+    if (data->has_vels) {
+      if (need > room / 2) {
+        vmdcon_printf(VMDCON_ERROR,
+          "rst7plugin) atom count %d does not fit in the file\n", numats);
+        free(data);
+        fclose(fd);
+        return NULL;
+      }
+    } else if (need > room) {
+      vmdcon_printf(VMDCON_ERROR,
+        "rst7plugin) atom count %d does not fit in the file\n", numats);
+      free(data);
+      fclose(fd);
+      return NULL;
+    }
+  }
+
   /* skip over coordinate data */
   for (i=0; i<numats; i++) {
     j = fscanf(fd, "%f%f%f", &x, &y, &z);
+    if (j != 3) {
+      vmdcon_printf(VMDCON_ERROR, "rst7plugin) coordinate scan ended early\n");
+      free(data);
+      fclose(fd);
+      return NULL;
+    }
   }
 
   /* skip over velocity data, if present */
   if (data->has_vels) {
     for (i=0; i<numats; i++) {
       j = fscanf(fd, "%f%f%f", &x, &y, &z);
+      if (j != 3) {
+        vmdcon_printf(VMDCON_ERROR, "rst7plugin) velocity scan ended early\n");
+        free(data);
+        fclose(fd);
+        return NULL;
+      }
     }
   }
   
