+
+static int js_read(jshandle *js, void *buf, size_t size) {
+  if (size == 0)
+    return 1;
+  return fio_fread(buf, size, 1, js->fd) == 1;
+}
+
+static void js_free_strings(char **table, int n) {
+  int i;
+  if (table == NULL)
+    return;
+  for (i=0; i<n; i++)
+    free(table[i]);
+  free(table);
+}
+
+/* records are not always NUL terminated, so each gets one extra byte */
+static char **js_read_strings(jshandle *js, int n, size_t recsize) {
+  int i;
+  char **table = (char **) calloc((size_t) n + 1, sizeof(char *));
+  if (table == NULL)
+    return NULL;
+  for (i=0; i<n; i++) {
+    table[i] = (char *) calloc(recsize + 1, sizeof(char));
+    if (table[i] == NULL || !js_read(js, table[i], recsize)) {
+      js_free_strings(table, i + 1);
+      return NULL;
+    }
+  }
+  return table;
