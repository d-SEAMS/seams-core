+/* Gaussian writes the route section and the title with format (x,A70)
+ * up to a line of dashes. Append the lines after the first one, which is
+ * in buffer, without their leading blank and line end. Trailing dashes
+ * are dropped and room for one more character is kept. FALSE at EOF. */
+static int join_dashed_block(char *buffer, size_t size, FILE *file) {
+  char line[BUFSIZ];
+  size_t len, offs = strcspn(buffer, "\r\n");
+
+  if (offs + 2 > size) offs = size - 2;
+  buffer[offs] = '\0';
+  while (fgets(line, sizeof(line), file)) {
+    if (line[0] == '\0') continue;
+    if (strncmp(line+1, "--", 2) == 0) {
+      while (offs > 0 && buffer[offs-1] == '-') buffer[--offs] = '\0';
+      return TRUE;
