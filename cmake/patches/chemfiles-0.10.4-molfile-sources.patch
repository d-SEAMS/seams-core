+/* DL_POLY Classic CONFIG headers have no atom count: count the records,
+   which are levcfg+2 lines per atom after the optional cell vectors */
+static int dlpoly_count_config_atoms(FILE *fd, int keytrj, int imcon) {
+  char line[4096];
+  long count = 0;
+  int i;
+
+  if (keytrj < 0 || keytrj > 2)
+    return -1;
+  if (imcon > 0) {
+    for (i = 0; i < 3; i++)
+      if (NULL == fgets(line, sizeof(line), fd))
+        return -1;
+  }
+  while (fgets(line, sizeof(line), fd)) {
+    if (strspn(line, " \t\r\n") != strlen(line))
+      count++;
+  }
+  if (count == 0 || count % (keytrj + 2) != 0 || count / (keytrj + 2) > INT_MAX)
+    return -1;
+  return (int) (count / (keytrj + 2));
+}
