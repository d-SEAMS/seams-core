# Copyright (c) d-SEAMS developers
# Edits inside chemfiles' molfiles.tar.gz, applied by
# chemfiles-0.10.4-external-sources.sh before chemfiles unpacks the archive.
#
# molfile_plugin.h gains the three QM fields cpmdlogplugin and
# gaussianplugin write (have_esp, have_internals, shell_symmetry), and
# those two plugins are compiled instead of being wrapped in `#if false`.
#
# Hostile files:
#   mdfplugin stops when the molecule section is truncated.
#   ReadPARM7.h bounds every %s to its buffer. The file's own notice
#   requires that change to be noted in comments; it is.
#   vtfplugin no longer walks off its line buffer, rejects a negative or
#   huge atom id, checks realloc, and refuses a token that does not fit
#   the molfile field.
#   rst7plugin rejects an atom count that does not fit in the bytes left
#   in the file, and stops when a coordinate scan comes up short.
#   tinkerplugin does the same for its atom count, and stops at EOF when
#   the count line has no newline.
diff -ruN molfiles-a/molfiles/CMakeLists.txt molfiles-b/molfiles/CMakeLists.txt
--- molfiles-a/molfiles/CMakeLists.txt	2021-09-10 14:18:46.000000000 +0000
+++ molfiles-b/molfiles/CMakeLists.txt	2026-11-20 21:08:20.990240902 +0000
@@ -24,3 +24,12 @@
 
 include_directories(include)
 add_library(molfiles OBJECT ${MOLFILES_SRC})
+# d-SEAMS: dmsplugin includes sqlite3.h. The chemfiles CMakeLists.txt finds
+# SQLite3 and sets SEAMS_SQLITE3_TARGET before adding this directory.
+# Linking here is in the directory that creates the target. The chemfiles
+# library also links the same target, because an OBJECT library's link
+# interface is not carried by $<TARGET_OBJECTS>.
+if(SEAMS_SQLITE3_TARGET)
+    target_include_directories(molfiles PRIVATE ${SQLite3_INCLUDE_DIRS})
+    target_link_libraries(molfiles PUBLIC ${SEAMS_SQLITE3_TARGET})
+endif()
