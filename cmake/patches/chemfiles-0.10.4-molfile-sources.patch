+/* The fields sit at fixed columns, so a short line must read as blank
+ * columns rather than the bytes after its terminator. */
+static const char *bgf_padded(const char *record, char *buf) {
+  size_t len = strlen(record);
+  if (len >= LINESIZE) len = LINESIZE - 1;
+  memcpy(buf, record, len);
+  memset(buf + len, 0, LINESIZE - len);
+  return buf;
+}
