+
 using namespace chemfiles;
 
 /******************************************************************************/
+// A DESRES trajectory (dtrplugin) is a directory. It holds `timekeys`, a
+// 12-byte prologue (magic 0x4445534b, frames per file, key record size)
+// followed by one 24-byte key per frame; the frame files, `frame%09d`,
+// each starting with the frame magic 0x4445534d; an optional `metadata`
+// frame; and an optional `.ddparams` (in `not_hashed/`, or at the top) that
+// spreads the frame files over hashed subdirectories. DESRES writers also
+// leave an empty `clickme.dtr` inside the directory for file pickers. Every
+// header word is big-endian.
+namespace {
+const uint32_t DESRES_TIMEKEY_MAGIC = 0x4445534b;
+const uint32_t DESRES_FRAME_MAGIC = 0x4445534d;
+const size_t DESRES_PROLOGUE_SIZE = 12;
+const size_t DESRES_KEY_SIZE = 24;
+const size_t DESRES_FRAME_HEADER_SIZE = 16;
+
+uint32_t desres_word(const unsigned char* bytes) {
+    return (static_cast<uint32_t>(bytes[0]) << 24) | (static_cast<uint32_t>(bytes[1]) << 16) |
+           (static_cast<uint32_t>(bytes[2]) << 8) | static_cast<uint32_t>(bytes[3]);
+}
+
+uint64_t desres_dword(const unsigned char* bytes) {
+    // a 64-bit key field is stored as its low word, then its high word
+    return (static_cast<uint64_t>(desres_word(bytes + 4)) << 32) | desres_word(bytes);
+}
+
+// The POSIX cksum of `name`. dtrplugin hashes a frame file name with it to
+// pick the subdirectory the file lives in.
+uint32_t desres_cksum(const std::string& name) {
+    auto add_byte = [](uint32_t crc, unsigned char byte) {
+        crc ^= static_cast<uint32_t>(byte) << 24;
+        for (int bit = 0; bit < 8; bit++) {
+            crc = (crc & 0x80000000u) ? (crc << 1) ^ 0x04C11DB7u : (crc << 1);
+        }
+        return crc;
+    };
+    uint32_t crc = 0;
+    for (char c : name) {
+        crc = add_byte(crc, static_cast<unsigned char>(c));
+    }
+    for (size_t length = name.size(); length != 0; length >>= 8) {
+        crc = add_byte(crc, static_cast<unsigned char>(length & 0xff));
+    }
+    return ~crc;
+}
+
+bool desres_stat(const std::string& path, struct stat& st) {
+    return stat(path.c_str(), &st) == 0;
+}
+
+// Reads `count` bytes at `offset`; false when the file is shorter.
+bool desres_read(const std::string& path, uint64_t offset, unsigned char* bytes, size_t count) {
+    std::FILE* file = std::fopen(path.c_str(), "rb");
+    if (file == nullptr) {
+        return false;
+    }
+    bool ok = true;
+    for (uint64_t skipped = 0; ok && skipped < offset; skipped++) {
+        ok = std::fgetc(file) != EOF;
+    }
+    ok = ok && std::fread(bytes, 1, count, file) == count;
+    std::fclose(file);
+    return ok;
+}
+
+bool desres_is_frame(const std::string& path, uint64_t offset) {
+    unsigned char header[DESRES_FRAME_HEADER_SIZE];
+    return desres_read(path, offset, header, sizeof(header)) &&
+           desres_word(header) == DESRES_FRAME_MAGIC;
+}
+
+// Checks `dir` the way dtrplugin reads it, and returns why it is not a
+// DESRES trajectory, or an empty string when it is one.
+std::string desres_problem(const std::string& dir) {
+    struct stat st;
+    const auto timekeys = dir + "/timekeys";
+    if (!desres_stat(timekeys, st) || !S_ISREG(st.st_mode)) {
+        return "it has no timekeys file";
+    }
+    const auto timekeys_size = static_cast<uint64_t>(st.st_size);
+    unsigned char prologue[DESRES_PROLOGUE_SIZE + DESRES_KEY_SIZE];
+    if (timekeys_size < DESRES_PROLOGUE_SIZE ||
+        !desres_read(timekeys, 0, prologue, DESRES_PROLOGUE_SIZE)) {
+        return "its timekeys file is shorter than the 12-byte prologue";
+    }
+    if (desres_word(prologue) != DESRES_TIMEKEY_MAGIC) {
+        return "its timekeys file does not start with the DESRES timekeys magic number";
+    }
+    const uint32_t frames_per_file = desres_word(prologue + 4);
+    if (frames_per_file == 0) {
+        return "its timekeys file declares zero frames per file";
+    }
+    if (desres_word(prologue + 8) != DESRES_KEY_SIZE) {
+        return "its timekeys file declares key records of " +
+               std::to_string(desres_word(prologue + 8)) + " bytes instead of 24";
+    }
+    if ((timekeys_size - DESRES_PROLOGUE_SIZE) % DESRES_KEY_SIZE != 0) {
+        return "its timekeys file ends inside a key record";
+    }
+    if (timekeys_size == DESRES_PROLOGUE_SIZE) {
+        return "its timekeys file has no frames";
+    }
+    if (!desres_read(timekeys, 0, prologue, sizeof(prologue))) {
+        return "its first timekey cannot be read";
+    }
+    const uint64_t offset = desres_dword(prologue + DESRES_PROLOGUE_SIZE + 8);
+    const uint64_t framesize = desres_dword(prologue + DESRES_PROLOGUE_SIZE + 16);
+    if (framesize < DESRES_FRAME_HEADER_SIZE || offset > UINT64_MAX - framesize) {
+        return "its first timekey does not describe a frame";
+    }
+
+    // dtrplugin reads .ddparams from not_hashed/ and falls back to the top
+    // of the directory only when that file does not exist.
+    int ndir1 = 0;
+    int ndir2 = 0;
+    for (const char* name : {"/not_hashed/.ddparams", "/.ddparams"}) {
+        const auto ddparams = dir + name;
+        if (!desres_stat(ddparams, st)) {
+            continue;
+        }
+        char text[64] = {0};
+        std::FILE* file = std::fopen(ddparams.c_str(), "rb");
+        size_t length = file == nullptr ? 0 : std::fread(text, 1, sizeof(text) - 1, file);
+        if (file != nullptr) {
+            std::fclose(file);
+        }
+        text[length] = '\0';
+        if (!S_ISREG(st.st_mode) || std::sscanf(text, "%d%d", &ndir1, &ndir2) != 2 ||
