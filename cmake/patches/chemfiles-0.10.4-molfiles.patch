+        return "its metadata is not a DESRES frame";
+    }
+
+    const std::string frame_name = "frame000000000";
+    std::string subdir;
+    if (ndir1 > 0) {
+        const uint32_t hash = desres_cksum(frame_name);
+        char buffer[32];
+        if (ndir2 > 0) {
+            std::snprintf(buffer, sizeof(buffer), "%03x/%03x/",
+                          static_cast<unsigned>(hash % static_cast<uint32_t>(ndir1)),
+                          static_cast<unsigned>((hash / static_cast<uint32_t>(ndir1)) %
+                                                static_cast<uint32_t>(ndir2)));
+        } else {
+            std::snprintf(buffer, sizeof(buffer), "%03x/",
+                          static_cast<unsigned>(hash % static_cast<uint32_t>(ndir1)));
+        }
+        subdir = buffer;
+    }
+    const auto first = dir + "/" + subdir + frame_name;
+    if (!desres_stat(first, st) || !S_ISREG(st.st_mode)) {
+        return "its first frame file " + subdir + frame_name + " is missing";
+    }
+    if (static_cast<uint64_t>(st.st_size) < offset + framesize) {
+        return "its first frame file is shorter than its timekey says";
+    }
+    if (!desres_is_frame(first, offset)) {
+        return "its first frame is not a DESRES frame";
+    }
+    return "";
+}
+
+// The directory of the DESRES trajectory at `path`: `path` itself, or the
+// directory holding `path` when it is an empty clickme.dtr.
+std::string desres_directory(const std::string& path) {
+    struct stat st;
+    if (!desres_stat(path, st)) {
+        throw format_error("could not open the DESRES trajectory at '{}'", path);
+    }
+    std::string dir;
+    if (S_ISDIR(st.st_mode)) {
+        dir = path;
+    } else {
+        const auto slash = path.find_last_of("/\\");
+        const auto base = slash == std::string::npos ? path : path.substr(slash + 1);
+        if (S_ISREG(st.st_mode) && st.st_size == 0 && base != "clickme.dtr") {
+            throw format_error("the file at '{}' is empty", path);
+        }
+        if (!S_ISREG(st.st_mode) || st.st_size != 0) {
+            throw format_error(
+                "'{}' is not a DESRES trajectory: a DESRES trajectory is a directory, "
+                "or the empty clickme.dtr inside one", path
+            );
+        }
+        dir = slash == std::string::npos ? std::string(".") : path.substr(0, slash);
+        if (dir.empty()) {
+            dir = "/";
+        }
+    }
+    const auto problem = desres_problem(dir);
+    if (!problem.empty()) {
+        if (dir == path) {
+            throw format_error("'{}' is not a DESRES trajectory: {}", path, problem);
+        }
+        throw format_error(
+            "'{}' is a clickme.dtr outside a DESRES trajectory: '{}' is not one, {}",
+            path, dir, problem
+        );
+    }
+    return dir;
+}
