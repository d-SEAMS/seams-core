 /// CIF files store which digits are insignificant, we need to remove this
 static double cif_to_double(std::string line);
 
+// The reader splits rows on whitespace and does not understand CIF quoting,
+// so a written value must be a single non-empty token.
+static std::string cif_token(const std::string& value) {
+    if (value.empty()) {
+        return "?";
+    }
+    auto token = value;
+    for (auto& c: token) {
+        if (std::isspace(static_cast<unsigned char>(c))) {
+            c = '_';
+        }
+    }
+    return token;
+}
+
+static std::string cif_value(string_view token) {
+    if (token == "?" || token == ".") {
+        return "";
+    }
+    return token.to_string();
+}
+
+// The model number in an _atom_site line
+static size_t model_number(string_view line, size_t column) {
+    auto line_split = split(line, ' ');
+    if (column >= line_split.size()) {
+        throw format_error("line '{}' has no model number in column {}", line, column + 1);
+    }
+    return parse<size_t>(line_split[column]);
+}
