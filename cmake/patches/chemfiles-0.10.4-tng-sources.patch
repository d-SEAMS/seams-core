+
+/* Records that a block of the frame set starting at frame has given values
+ * to particles [first, first + n). A block read again sets the same bits,
+ * so n_particles_set never counts a particle twice. */
+static tng_function_status tng_data_particles_set_mark(struct tng_data* data,
+                                                       const int64_t    frame,
+                                                       const int64_t    first,
+                                                       const int64_t    n)
+{
+    int64_t i;
+    size_t  len;
+
+    if ((uint64_t)(data->alloc_particles / 8 + 1) > SIZE_MAX)
+    {
+        return (TNG_CRITICAL);
+    }
+    len = (size_t)(data->alloc_particles / 8 + 1);
+    if (!data->particles_set)
+    {
+        data->particles_set = (unsigned char*)calloc(len, 1);
+        if (!data->particles_set)
+        {
+            fprintf(stderr, "TNG library: Cannot allocate memory. %s: %d\n", __FILE__, __LINE__);
+            return (TNG_CRITICAL);
+        }
+        data->particles_set_frame = frame;
+    }
+    if (data->particles_set_frame != frame)
+    {
+        memset(data->particles_set, 0, len);
+        data->n_particles_set     = 0;
+        data->particles_set_frame = frame;
+    }
+    for (i = first; i < first + n; i++)
+    {
+        if (!(data->particles_set[i / 8] & (1u << (i % 8))))
+        {
+            data->particles_set[i / 8] |= (unsigned char)(1u << (i % 8));
+            data->n_particles_set++;
+        }
+    }
+    return (TNG_SUCCESS);
+}
