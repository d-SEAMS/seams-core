+    if (size <= 0 || a <= 0 || b <= 0 || c <= 0 || a > INT64_MAX / size / b / c
+        || (uint64_t)(size * a * b * c) > SIZE_MAX)
+    {
+        fprintf(stderr, "TNG library: Data block is too large. %s: %d\n", __FILE__, __LINE__);
+        return (TNG_CRITICAL);
+    }
+    /* The old values have another shape, and a particle no block has given
+     * values to must not read as uninitialised memory. */
+    free(data->values);
+    data->values = 0;
+    values       = calloc((size_t)(size * a * b * c), 1);
+    if (!values)
+    {
+        fprintf(stderr, "TNG library: Cannot allocate memory. %s: %d\n", __FILE__, __LINE__);
+        return (TNG_CRITICAL);
+    }
+    data->values = values;
+    return (TNG_SUCCESS);
+}
