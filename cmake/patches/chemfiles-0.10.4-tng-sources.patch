+/* Replaces data->values with size * a * b * c zeroed bytes. */
+static tng_function_status tng_data_values_realloc(struct tng_data* data,
+                                                   const int64_t    size,
+                                                   const int64_t    a,
+                                                   const int64_t    b,
+                                                   const int64_t    c)
