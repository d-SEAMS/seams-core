+/* Frees data->strings with the sizes it was allocated with. Every level
+ * may be partly allocated after a failed allocation. */
+static void tng_data_strings_free(struct tng_data* data)
+{
+    int64_t i, j, k;
+
+    if (data->strings)
+    {
+        for (i = 0; i < data->strings_dim[0]; i++)
+        {
+            if (!data->strings[i])
+            {
+                continue;
+            }
+            for (j = 0; j < data->strings_dim[1]; j++)
+            {
+                if (!data->strings[i][j])
+                {
+                    continue;
+                }
+                for (k = 0; k < data->strings_dim[2]; k++)
+                {
+                    free(data->strings[i][j][k]);
+                }
+                free(data->strings[i][j]);
+            }
+            free(data->strings[i]);
+        }
+        free(data->strings);
+    }
+    data->strings        = 0;
+    data->strings_dim[0] = 0;
+    data->strings_dim[1] = 0;
+    data->strings_dim[2] = 0;
+}
