+/* Frees data->strings with the sizes it was allocated with. Every level
+ * may be partly allocated after a failed allocation. */
+static void tng_data_strings_free(struct tng_data* data)
+{
+    int64_t i, j, k;
+
+    if (data->strings)
+    {
+        for (i = 0; i < data->strings_dim[0]; i++)
+        {
+            if (!data->strings[i])
+            {
+                continue;
+            }
+            for (j = 0; j < data->strings_dim[1]; j++)
+            {
+                if (!data->strings[i][j])
+                {
+                    continue;
+                }
+                for (k = 0; k < data->strings_dim[2]; k++)
+                {
+                    free(data->strings[i][j][k]);
+                }
+                free(data->strings[i][j]);
+            }
+            free(data->strings[i]);
+        }
+        free(data->strings);
+    }
+    data->strings        = 0;
+    data->strings_dim[0] = 0;
+    data->strings_dim[1] = 0;
+    data->strings_dim[2] = 0;
+}
+
+/* Allocates data->strings as d0 x d1 x d2 null string pointers. */
+static tng_function_status tng_data_strings_alloc(struct tng_data* data,
+                                                  const int64_t    d0,
+                                                  const int64_t    d1,
+                                                  const int64_t    d2)
+{
+    int64_t i, j;
+
+    tng_data_strings_free(data);
+    if (d0 <= 0 || d1 <= 0 || d2 <= 0 || (uint64_t)d0 > SIZE_MAX / sizeof(char***)
+        || (uint64_t)d1 > SIZE_MAX / sizeof(char**) || (uint64_t)d2 > SIZE_MAX / sizeof(char*))
+    {
+        return (TNG_CRITICAL);
+    }
+    data->strings = (char****)calloc((size_t)d0, sizeof(char***));
+    if (!data->strings)
+    {
+        fprintf(stderr, "TNG library: Cannot allocate memory. %s: %d\n", __FILE__, __LINE__);
+        return (TNG_CRITICAL);
+    }
+    data->strings_dim[0] = d0;
+    data->strings_dim[1] = d1;
+    data->strings_dim[2] = d2;
+    for (i = 0; i < d0; i++)
+    {
+        data->strings[i] = (char***)calloc((size_t)d1, sizeof(char**));
+        if (!data->strings[i])
+        {
+            fprintf(stderr, "TNG library: Cannot allocate memory. %s: %d\n", __FILE__, __LINE__);
+            return (TNG_CRITICAL);
+        }
+        for (j = 0; j < d1; j++)
+        {
+            data->strings[i][j] = (char**)calloc((size_t)d2, sizeof(char*));
+            if (!data->strings[i][j])
+            {
+                fprintf(stderr, "TNG library: Cannot allocate memory. %s: %d\n", __FILE__, __LINE__);
+                return (TNG_CRITICAL);
+            }
+        }
+    }
+    return (TNG_SUCCESS);
+}
