+        fprintf(stderr, "TNG library: Cannot allocate memory. %s: %d\n", __FILE__, __LINE__);
+        return (TNG_CRITICAL);
+    }
+    data->strings_dim[0] = d0;
+    data->strings_dim[1] = d1;
+    data->strings_dim[2] = d2;
+    for (i = 0; i < d0; i++)
