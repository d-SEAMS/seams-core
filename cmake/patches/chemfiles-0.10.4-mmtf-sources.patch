#
# Hostile files, mmtf-cpp/include/mmtf/binary_decoder.hpp:
#   Run-length pairs must be complete, with non-negative runs that add up
#   to no more than the binary's declared length; the decoder reserved the
#   sum of the runs before (53 GB for a 65 kB file).
#   Delta and recursive-index sums that overflow their integer type, a
#   string length below one and a zero divisor are decode errors. A binary
#   shorter than its 12-byte header is an error from both constructors.
# mmtf-cpp/include/mmtf/msgpack_decoders.hpp: a transform matrix must
#   have its 16 values; a shorter one left the rest of the matrix unset.
# mmtf-cpp/msgpack-c/include/msgpack/v1/adaptor/carray.hpp: converting
#   an empty msgpack array into a C array no longer dereferences its null
#   element pointer, as the vector and std::array adaptors already did.
